# Copy to api/.env and fill in. Never commit the real .env.

# --- Core ---
MONGO_URI=mongodb://localhost:27017/replo
PORT=6969

# Auth token signing secrets (set strong, unique values in production).
JWT_SECRET=change_me
REFRESH_SECRET=change_me

# --- Owner signup notifications (optional) ---
# Leave RESEND_API_KEY or OWNER_EMAIL unset to disable email notifications
# (e.g. in local dev) — the app no-ops cleanly.
RESEND_API_KEY=
OWNER_EMAIL=you@gmail.com
# Verified-domain sender in production. Defaults to Resend's shared test sender,
# which only delivers to your own Resend account email.
NOTIFY_FROM_EMAIL=Replo <onboarding@resend.dev>
