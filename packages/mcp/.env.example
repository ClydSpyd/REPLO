# =========================================================================
# @replo/mcp — environment. Copy to `.env` (gitignored) and fill in.
# This file holds PLACEHOLDERS ONLY — never put real secrets here.
# =========================================================================

# --- Upstream REPLO API (the server calls /api/* here) ---
REPLO_API_URL=http://localhost:6969

# --- Dev credentials (M1 only) ---
# Until OAuth lands (M3), the server logs in as one fixed user with these.
# Use a real REPLO account. Replaced by per-user OAuth tokens later.
REPLO_EMAIL=you@example.com
REPLO_PASSWORD=your-password

# --- This MCP server ---
PORT=8080
# Public origin of THIS server. Becomes the OAuth canonical URI (resource
# indicator) and is baked into the discovery metadata.
#   Dev  : your HTTPS tunnel origin, e.g. https://xxxx.trycloudflare.com
#   Prod : the public hostname behind REPLO's TLS/reverse proxy
MCP_PUBLIC_URL=http://localhost:8080

# --- OAuth (used from milestone M3 onward; leave blank until then) ---
# Signing key for the access tokens WE issue (Token A). Generate a strong random value.
MCP_TOKEN_SIGNING_KEY=
# Token lifetimes (seconds): short-lived access token + longer refresh token.
MCP_ACCESS_TOKEN_TTL=900
MCP_REFRESH_TOKEN_TTL=2592000
